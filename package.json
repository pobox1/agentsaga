{
  "name": "agentsaga",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "contracts:generate-abi": "pnpm --filter @agentsaga/contracts generate:abi",
    "contracts:check-abi": "pnpm --filter @agentsaga/contracts check:abi",
    "deployment:validate": "node scripts/validate-deployment.mjs",
    "dev": "pnpm --filter @agentsaga/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:contracts": "./.tools/foundry/forge test -vvv",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "next": "16.2.11"
  }
}
