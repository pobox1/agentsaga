{
  "name": "@agentsaga/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-process.js",
    "start:indexer": "node dist/indexer-process.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage.enabled=false",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@agentsaga/contracts": "workspace:*",
    "@prisma/client": "6.19.0",
    "bullmq": "5.80.10",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "viem": "2.55.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
