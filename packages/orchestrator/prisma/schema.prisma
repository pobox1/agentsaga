generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChainCursor {
  id             String   @id
  chainId        Int
  nextBlock      BigInt
  lastBlockHash  String?
  updatedAt      DateTime @updatedAt
}

model IndexedEvent {
  id               String   @id
  sourceId         String
  chainId          Int
  transactionHash  String
  logIndex         Int
  blockNumber      BigInt
  blockHash        String
  eventName        String
  payload          Json
  projectionStatus String   @default("received")
  projectionAttempts Int    @default(0)
  lastProjectionError String?
  nextProjectionAttemptAt DateTime?
  processingStartedAt DateTime?
  projectionLeaseOwner String?
  projectionLeaseExpiresAt DateTime?
  processedAt      DateTime?
  createdAt        DateTime @default(now())

  @@unique([chainId, transactionHash, logIndex])
  @@index([chainId, blockNumber])
  @@index([sourceId, projectionStatus, nextProjectionAttemptAt], map: "IndexedEvent_projection_queue_idx")
  @@index([projectionStatus, nextProjectionAttemptAt])
  @@index([sourceId, blockNumber, logIndex], map: "IndexedEvent_source_order_idx")
}

model WorkerAction {
  id             String   @id
  workflow       String
  nodeId         Int?
  action         String
  idempotencyKey String   @unique
  status         String
  attempts       Int      @default(0)
  executionAttempts Int   @default(0)
  resumeAttempts Int      @default(0)
  resumeSequence Int      @default(0)
  nextAttemptAt DateTime?
  waitingReason String?
  lastResult    Json?
  transactionHash String?
  transactionNonce Int?
  signerRole    String?
  startedAt     DateTime?
  completedAt   DateTime?
  leaseOwner    String?
  leaseExpiresAt DateTime?
  lastError      String?
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workflow, status])
  @@index([status, nextAttemptAt])
}

model QueueOutbox {
  id               String   @id
  queue            String
  idempotencyKey   String
  actionId         String?
  resumeSequence   Int      @default(0)
  executionAttempt Int      @default(0)
  payload          Json
  status           String   @default("pending")
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  publishedAt      DateTime?
  attempts         Int      @default(0)
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([actionId, resumeSequence, executionAttempt])
  @@index([status, leaseExpiresAt, createdAt])
}

model TransactionIntent {
  id               String   @id
  logicalActionKey String   @unique
  workflowAddress  String
  chainId          Int
  action           String
  requestHash      String
  sender           String
  target           String
  status           String
  transactionHash  String?
  payload          Json
  preparedAt       DateTime @default(now())
  broadcastStartedAt DateTime?
  submittedAt      DateTime?
  resolvedAt       DateTime?
  lastError        String?
  updatedAt        DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([workflowAddress, action])
}

model ExecutionRecord {
  id        String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  address          String   @id
  chainId          Int
  owner            String
  paymentToken     String?
  status           String
  statusCode       Int?
  statusLabel      String?
  totalBudget      String?
  nodeCount        Int?
  createdBlock     BigInt
  finalizedBlock   BigInt?
  state            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  nodes            WorkflowNode[]
  executions       AgentExecution[]
  decisions        EvaluatorDecision[]
  transactions     ChainTransaction[]
  evidence         EvidenceRecord[]
  jobs             WorkflowJob[]

  @@index([chainId, status])
  @@index([owner])
}

model WorkflowJob {
  id              String   @id
  workflowAddress String
  nodeId          Int
  jobId           String
  jobType         String
  provider        String?
  evaluator       String?
  budget          String?
  expiry          DateTime?
  specificationHash String?
  status          String
  createdBlock    BigInt
  state           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workflow        Workflow @relation(fields: [workflowAddress], references: [address], onDelete: Cascade)

  @@unique([workflowAddress, jobId])
  @@index([workflowAddress, nodeId, jobType])
}

model ProcessorCapability {
  processor       String   @id
  status          String
  mode            String
  detail          String?
  configuredStatus String?
  dependencyStatus String?
  signerAvailability String?
  signerRole      String?
  adapterAvailability String?
  operational     Boolean  @default(false)
  configVersion   String?
  configHash      String?
  processId       Int?
  gitCommit       String?
  heartbeatAt     DateTime?
  updatedAt       DateTime @updatedAt
}

model WorkflowNode {
  id              String   @id
  workflowAddress String
  nodeId          Int
  status          String
  provider        String?
  evaluator       String?
  jobId           String?
  state           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workflow        Workflow @relation(fields: [workflowAddress], references: [address], onDelete: Cascade)

  @@unique([workflowAddress, nodeId])
  @@index([workflowAddress, status])
}

model AgentExecution {
  id              String   @id
  workflowAddress String
  nodeId          Int
  jobId           String
  executionType   String
  agentId         String
  status          String
  input           Json
  output          Json?
  evidenceHash    String?
  cost            String?
  error            String?
  startedAt       DateTime
  completedAt     DateTime?
  workflow        Workflow @relation(fields: [workflowAddress], references: [address], onDelete: Cascade)

  @@unique([workflowAddress, nodeId, jobId, executionType])
  @@index([workflowAddress, nodeId, executionType])
}

model EvaluatorDecision {
  id              String   @id
  workflowAddress String
  nodeId          Int
  jobId           String
  executionType   String
  evaluatorId     String
  decision        String
  reasonCode      String
  evidenceHash    String
  evaluatedAt     DateTime
  workflow        Workflow @relation(fields: [workflowAddress], references: [address], onDelete: Cascade)

  @@unique([workflowAddress, nodeId, jobId, executionType], map: "EvaluatorDecision_job_context_key")
  @@index([workflowAddress, nodeId, executionType])
}

model ChainTransaction {
  hash            String   @id
  workflowAddress String?
  chainId         Int
  action          String
  logicalActionKey String?
  status          String
  blockNumber     BigInt?
  fromAddress     String?
  toAddress       String?
  transactionNonce Int?
  verificationMethod String?
  verificationResult Json?
  lastCheckedAt   DateTime?
  recoveryAttempts Int @default(0)
  replacedByHash  String?
  payload         Json
  submittedAt     DateTime
  confirmedAt     DateTime?
  workflow        Workflow? @relation(fields: [workflowAddress], references: [address], onDelete: SetNull)

  @@index([workflowAddress, action])
  @@index([logicalActionKey, status])
}

model IdempotencyRecord {
  key         String   @id
  operation   String
  status      String
  result      Json?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeadLetterRecord {
  id             String   @id
  queue          String
  originalJobId  String?
  payload        Json
  error          String
  attempts       Int
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([queue, resolvedAt])
}

model EvidenceRecord {
  id              String   @id
  workflowAddress String
  nodeId          Int?
  kind            String
  commitment      String
  uri             String?
  transactionHash String?
  metadata        Json
  createdAt       DateTime @default(now())
  workflow        Workflow @relation(fields: [workflowAddress], references: [address], onDelete: Cascade)

  @@index([workflowAddress, nodeId])
}
